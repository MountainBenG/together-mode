# Copy this file to ".env" and fill in your real values, then restart Expo.
# (The real .env is gitignored — keep your keys out of git. This file is just the template.)

# Supabase → dashboard → Settings → API.
# Use the legacy "anon" / "public" JWT key (the long one that starts with eyJ),
# NOT the sb_publishable_ key (that one gets rejected).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# TMDB → themoviedb.org → account Settings → API.
EXPO_PUBLIC_TMDB_API_KEY=your-tmdb-api-key
